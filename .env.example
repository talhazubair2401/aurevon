# Every setting the AureVon services read. Copy to .env for local overrides; never commit real values.
# Local Docker Compose sets safe development values itself (infra/compose.yaml).

# --- Django API, worker and scheduler ---
DJANGO_SETTINGS_MODULE=config.settings.local        # local | test | staging | production
DJANGO_SECRET_KEY=change-me                         # long random value in staging/production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1            # required in production
DJANGO_CSRF_TRUSTED_ORIGINS=                        # e.g. https://aurevon.pk (production)
DATABASE_URL=postgres://aurevon:aurevon@localhost:5432/aurevon
DATABASE_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
SITE_URL=http://localhost:8080                      # public base URL used in emailed links
TRUSTED_PROXY_COUNT=0                               # reverse-proxy hops in front of the API (local stack: 1)
MFA_ENCRYPTION_KEY=                                 # required in production: Fernet key for authenticator secrets
                                                    #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Storefront cache refresh on CMS publish (decision 0005). Same secret on the API worker and the storefront ---
STOREFRONT_INTERNAL_URL=http://localhost:3000       # how the API worker reaches the storefront (internal network)
STOREFRONT_REVALIDATE_SECRET=                       # long random value (at least 16 characters); empty: refresh within a minute

# --- Storefront search settings (M17) ---
# SITE_URL above is also the storefront's public address for canonical URLs, hreflang and the sitemap.
SITE_INDEXABLE=false                                # true only in production: lets search engines index the store

# --- Email (local: Mailpit on localhost:1025, web UI http://localhost:8025) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=AureVon <no-reply@aurevon.pk>

# --- Production-only security switches (defaults are secure) ---
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_PRELOAD=false                           # true once the domain is stable (MTS §12)

# --- Reverse proxy (Content-Security-Policy-Report-Only during V-05) ---
STOREFRONT_CSP=
STAFF_CSP=
